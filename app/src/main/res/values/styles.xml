<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#61E9B6</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#10151E</item>
        <item name="android:navigationBarColor">#10151E</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#10151E</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SettingsDialogTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#61E9B6</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
</resources>
